@using BADEAPORTAL.Services
@using System.Globalization
@inject IUserProfileService UserProfileService

@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isArabic = culture == "ar";
    var dir = isArabic ? "rtl" : "ltr";
    var lang = isArabic ? "ar" : "en";

    var userProfile = UserProfileService.GetCurrentUser();
    var greetingName = userProfile.FullName ?? userProfile.DisplayName ?? "BADEA";

    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}

<!DOCTYPE html>
<html lang="@lang" dir="@dir">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BADEA Portal</title>

    @if (isArabic)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BADEAPORTAL.styles.css" asp-append-version="true" />

    <style>
            body.portal-body {
                background: #f3f5f7;
                min-height: 100vh;
            }

            .portal-navbar {
                position: sticky;
                top: 0;
                z-index: 1030;
                background: rgba(255, 255, 255, .9);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid rgba(0, 0, 0, .05);
            }

            .portal-nav-pills .nav-link {
                border-radius: 999px;
                padding: .5rem 1rem;
                font-weight: 600;
            }

            .portal-nav-pills .nav-link.active {
                background: #009639;
                color: #fff;
            }
    </style>
</head>

<body class="portal-body">

    <div id="top"></div>

    <header class="portal-navbar">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-3 px-lg-4">

                <a asp-controller="Home" asp-action="Index" class="navbar-brand">
                    BADEA
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portalTopNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="portalTopNav">
                    <ul class="navbar-nav portal-nav-pills mx-auto gap-2">

                        <li class="nav-item">
                            <a class="nav-link active" href="#top" data-nav="overview">
                                @(isArabic ? "الرئيسية" : "Overview")
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#tools-section" data-nav="tools">
                                @(isArabic ? "الأنظمة والأدوات" : "Tools")
                            </a>
                        </li>

                    </ul>

                    <div class="d-flex gap-2">

                        <a class="btn btn-sm btn-outline-success" asp-controller="Home" asp-action="SetLanguage"
                               asp-route-culture="@(isArabic ? "en" : "ar")" asp-route-returnUrl="@returnUrl">
                            @(isArabic ? "English" : "العربية")
                        </a>

                        <div class="px-2 small">
                            @greetingName
                        </div>

                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container-fluid py-3">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            document.addEventListener('DOMContentLoaded', function () {

                const overviewLink = document.querySelector('[data-nav="overview"]');
                const toolsLink = document.querySelector('[data-nav="tools"]');
                const toolsSection = document.getElementById('tools-section');

                if (!overviewLink || !toolsLink || !toolsSection) return;

                function setActive(link) {
                    document.querySelectorAll('.portal-nav-pills .nav-link')
                        .forEach(x => x.classList.remove('active'));

                    link.classList.add('active');
                }

                overviewLink.addEventListener('click', function (e) {
                    e.preventDefault();

                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });

                    history.replaceState(null, '', window.location.pathname);
                    setActive(overviewLink);
                });

                toolsLink.addEventListener('click', function (e) {
                    e.preventDefault();

                    toolsSection.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });

                    history.replaceState(null, '', '#tools-section');
                    setActive(toolsLink);
                });

                window.addEventListener('scroll', function () {
                    const toolsTop = toolsSection.getBoundingClientRect().top;

                    if (toolsTop <= 120) {
                        setActive(toolsLink);
                    } else {
                        setActive(overviewLink);
                    }
                });

            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>