@using System.Globalization
@model ErrorViewModel

@{
    Layout = null;

    var isArabic =
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";

    var pageTitle = isArabic
        ? "حدث خطأ"
        : "Something went wrong";

    var logoPath = isArabic
        ? Url.Content("~/images/logo-ar.png")
        : Url.Content("~/images/logo-en.png");
}

<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - BADEA Portal</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #15231b;
            background:
                radial-gradient(circle at top left, rgba(0, 150, 57, 0.10), transparent 34rem),
                #f3f5f7;
        }

        .error-card {
            width: min(100%, 680px);
            padding: clamp(32px, 6vw, 56px);
            text-align: center;
            background: rgba(255, 255, 255, 0.97);
            border: 1px solid rgba(21, 35, 27, 0.08);
            border-radius: 24px;
            box-shadow: 0 24px 70px rgba(21, 35, 27, 0.10);
        }

        .logo {
            display: block;
            width: min(210px, 62vw);
            max-height: 78px;
            object-fit: contain;
            margin: 0 auto 30px;
        }

        .error-icon {
            width: 72px;
            height: 72px;
            margin: 0 auto 22px;
            display: grid;
            place-items: center;
            border-radius: 20px;
            color: #007d31;
            background: rgba(0, 150, 57, 0.10);
            font-size: 34px;
            font-weight: 700;
        }

        h1 {
            margin: 0;
            font-size: clamp(30px, 5vw, 42px);
            line-height: 1.15;
            font-weight: 800;
        }

        .message {
            max-width: 530px;
            margin: 16px auto 0;
            color: #66736c;
            font-size: 16px;
            line-height: 1.75;
        }

        .home-button {
            display: inline-block;
            margin-top: 28px;
            padding: 12px 24px;
            min-width: 160px;
            border-radius: 999px;
            color: #ffffff;
            background: #009639;
            border: 1px solid #009639;
            text-decoration: none;
            font-weight: 700;
            box-shadow: 0 10px 24px rgba(0, 150, 57, 0.20);
            transition: transform 0.18s ease, background 0.18s ease;
        }

        .home-button:hover,
        .home-button:focus {
            color: #ffffff;
            background: #007d31;
            transform: translateY(-1px);
        }

        .reference {
            margin-top: 30px;
            padding-top: 18px;
            border-top: 1px solid rgba(21, 35, 27, 0.08);
            color: #8a948e;
            font-size: 13px;
        }

        .reference code {
            display: inline-block;
            max-width: 100%;
            margin-inline-start: 4px;
            padding: 3px 7px;
            border-radius: 6px;
            color: #566159;
            background: #f3f5f4;
            overflow-wrap: anywhere;
        }
    </style>
</head>
<body>
    <main class="error-card">
        <img class="logo" src="@logoPath" alt="BADEA" />

        <div class="error-icon" aria-hidden="true">!</div>

        <h1>
            @(isArabic
                ? "عذراً، حدث خطأ غير متوقع"
                : "Something went wrong")
        </h1>

        <p class="message">
            @(isArabic
                ? "تعذر إكمال الطلب. يرجى العودة إلى البوابة والمحاولة مرة أخرى. إذا استمرت المشكلة، يرجى مشاركة الرقم المرجعي أدناه مع فريق تقنية المعلومات."
                : "We couldn't complete your request. Please return to the portal and try again. If the problem continues, share the reference ID below with the IT team.")
        </p>

        <a class="home-button" href="/">
            @(isArabic
                ? "العودة إلى البوابة"
                : "Back to portal")
        </a>

        @if (Model?.ShowRequestId == true)
        {
            <div class="reference">
                <span>
                    @(isArabic
                        ? "الرقم المرجعي:"
                        : "Reference ID:")
                </span>
                <code>@Model.RequestId</code>
            </div>
        }
    </main>
</body>
</html>
