@model List<BADEAPORTAL.Models.PortalSystemCard>

@{
    ViewData["Title"] = "System Cards Admin";
}

<style>
    .admin-page {
        font-family: 'Tajawal', sans-serif;
    }

    .admin-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        padding: 2rem;
        background:
            linear-gradient(135deg, rgba(0, 150, 57, 0.10), rgba(13, 110, 253, 0.06)),
            rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.45);
        box-shadow:
            0 10px 35px rgba(0, 0, 0, 0.06),
            inset 0 1px 0 rgba(255, 255, 255, 0.55);
    }

    .admin-hero::before {
        content: "";
        position: absolute;
        top: -120px;
        right: -120px;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: rgba(0, 150, 57, 0.08);
    }

    .admin-title {
        font-size: 2rem;
        font-weight: 700;
        color: #111827;
    }

    .admin-subtitle {
        color: #6b7280;
        font-size: 1rem;
    }

    .admin-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.45);
        border-radius: 24px;
        box-shadow:
            0 10px 30px rgba(0, 0, 0, 0.05),
            inset 0 1px 0 rgba(255, 255, 255, 0.5);
    }

    .admin-table th {
        font-size: 0.9rem;
        font-weight: 700;
        color: #6b7280;
        border-bottom: 1px solid #eef2f7;
        background: transparent !important;
        padding: 1rem;
    }

    .admin-table td {
        padding: 1rem;
        vertical-align: middle;
        border-bottom: 1px solid #f3f4f6;
    }

    .admin-table tr:last-child td {
        border-bottom: none;
    }

    .tool-logo {
        width: 52px;
        height: 52px;
        object-fit: contain;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid #eef2f7;
        padding: 0.35rem;
    }

    .tool-name {
        font-weight: 700;
        color: #111827;
    }

    .tool-meta {
        color: #6b7280;
        font-size: 0.88rem;
        word-break: break-all;
    }

    .glass-btn {
        border-radius: 14px;
        padding: 0.55rem 0.95rem;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: all 0.2s ease;
    }

    .glass-btn:hover {
        transform: translateY(-1px);
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.42rem 0.85rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.82rem;
    }

    .status-active {
        background: rgba(25, 135, 84, 0.12);
        color: #198754;
    }

    .status-hidden {
        background: rgba(108, 117, 125, 0.14);
        color: #6c757d;
    }

    .status-public {
        background: rgba(13, 110, 253, 0.12);
        color: #0d6efd;
    }

    .status-restricted {
        background: rgba(255, 193, 7, 0.18);
        color: #856404;
    }
</style>

<div class="container py-4 admin-page">

    <div class="admin-hero mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

            <div>
                <div class="admin-title mb-2">
                    System Cards
                </div>

                <div class="admin-subtitle">
                    Manage portal tools, links, visibility and logos.
                </div>
            </div>

            <div>
                <a asp-action="Create" class="btn btn-success glass-btn">
                    Add Tool
                </a>
            </div>

        </div>
    </div>

    <div class="admin-card p-0 overflow-hidden">

        <div class="table-responsive">

            <table class="table admin-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Logo</th>
                        <th>Name</th>
                        <th>Arabic</th>
                        <th>Category</th>
                        <th>Active</th>
                        <th>Public</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var card in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrWhiteSpace(card.LogoPath) ? Url.Content("~/images/logo-en.png") : card.LogoPath)"
                                     class="tool-logo"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/images/logo-en.png")';" />
                            </td>

                            <td>
                                <div class="tool-name">
                                    @card.SysNameEn
                                </div>

                                <div class="tool-meta">
                                    @card.AppUrl
                                </div>
                            </td>

                            <td>
                                <div dir="rtl">
                                    @card.SysNameAr
                                </div>
                            </td>

                            <td>
                                <span class="tool-meta">
                                    @card.CategoryEn
                                </span>
                            </td>

                            <td>
                                <span class="status-pill @(card.IsActive == 1 ? "status-active" : "status-hidden")">
                                    @(card.IsActive == 1 ? "Active" : "Hidden")
                                </span>
                            </td>

                            <td>
                                <span class="status-pill @(card.IsPublic == 1 ? "status-public" : "status-restricted")">
                                    @(card.IsPublic == 1 ? "Public" : "Restricted")
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@card.CardId"
                                           class="btn btn-sm btn-outline-primary glass-btn">
                                        Edit
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@card.CardId"
                                           class="btn btn-sm btn-outline-danger glass-btn">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>