@model List<BADEAPORTAL.Models.PortalSystemCard>

@{
    ViewData["Title"] = "System Cards Admin";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">System Cards</h2>
            <p class="text-muted mb-0">Manage portal tools, links and logos.</p>
        </div>

        <a asp-action="Create" class="btn btn-success">Add Tool</a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Logo</th>
                        <th>Name</th>
                        <th>Arabic</th>
                        <th>Category</th>
                        <th>Active</th>
                        <th>Public</th>
                        <th style="width: 170px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var card in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrWhiteSpace(card.LogoPath) ? Url.Content("~/images/logo-en.png") : card.LogoPath)"
                                     style="width:48px;height:48px;object-fit:contain;border-radius:12px;"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/images/logo-en.png")';" />
                            </td>
                            <td>
                                <strong>@card.SysNameEn</strong>
                                <div class="small text-muted">@card.AppUrl</div>
                            </td>
                            <td>@card.SysNameAr</td>
                            <td>@card.CategoryEn</td>
                            <td>
                                <span class="badge @(card.IsActive == 1 ? "bg-success" : "bg-secondary")">
                                    @(card.IsActive == 1 ? "Active" : "Hidden")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(card.IsPublic == 1 ? "bg-primary" : "bg-warning text-dark")">
                                    @(card.IsPublic == 1 ? "Public" : "Restricted")
                                </span>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@card.CardId"
                                   class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@card.CardId"
                                   class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>