@model BADEAPORTAL.Models.Admin.SystemCardFormVm

@{
    ViewData["Title"] = "Add Tool";
}

<style>
    .admin-page {
        font-family: 'Tajawal', sans-serif;
    }

    .admin-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        padding: 2rem;
        background:
            linear-gradient(135deg, rgba(0, 150, 57, 0.10), rgba(13, 110, 253, 0.06)),
            rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.45);
        box-shadow:
            0 10px 35px rgba(0, 0, 0, 0.06),
            inset 0 1px 0 rgba(255, 255, 255, 0.55);
    }

    .admin-title {
        font-size: 2rem;
        font-weight: 700;
        color: #111827;
    }

    .admin-subtitle {
        color: #6b7280;
        font-size: 1rem;
    }

    .glass-btn {
        border-radius: 14px;
        padding: 0.6rem 1rem;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: all 0.2s ease;
    }

    .glass-btn:hover {
        transform: translateY(-1px);
    }
</style>

<div class="container py-4 admin-page">

    <div class="admin-hero mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

            <div>
                <div class="admin-title mb-2">
                    Add Tool
                </div>

                <div class="admin-subtitle">
                    Create a new system card for the portal homepage.
                </div>
            </div>

            <div>
                <a asp-action="Index" class="btn btn-light glass-btn">
                    ← Back
                </a>
            </div>

        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <partial name="_Form" model="Model" />

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-light glass-btn">
                Cancel
            </a>

            <button type="submit" class="btn btn-success glass-btn">
                Create Tool
            </button>
        </div>

    </form>

</div>