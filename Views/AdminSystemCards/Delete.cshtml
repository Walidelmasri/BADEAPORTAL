@model BADEAPORTAL.Models.PortalSystemCard

@{
    ViewData["Title"] = "Deactivate Tool";
}

<style>
    .admin-page {
        font-family: 'Tajawal', sans-serif;
    }

    .danger-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(220, 53, 69, 0.18);
        border-radius: 24px;
        box-shadow:
            0 10px 30px rgba(0, 0, 0, 0.05),
            inset 0 1px 0 rgba(255, 255, 255, 0.5);
    }

    .danger-title {
        font-size: 2rem;
        font-weight: 700;
        color: #dc3545;
    }

    .danger-subtitle {
        color: #6b7280;
        font-size: 1rem;
    }

    .tool-logo-preview {
        width: 74px;
        height: 74px;
        object-fit: contain;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid #eef2f7;
        padding: 0.5rem;
    }

    .tool-name {
        font-weight: 700;
        color: #111827;
        font-size: 1.15rem;
    }

    .tool-meta {
        color: #6b7280;
        font-size: 0.92rem;
        word-break: break-all;
    }

    .glass-btn {
        border-radius: 14px;
        padding: 0.6rem 1rem;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: all 0.2s ease;
    }

    .glass-btn:hover {
        transform: translateY(-1px);
    }
</style>

<div class="container py-4 admin-page">

    <div class="danger-card p-4">

        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">

            <div>
                <div class="danger-title mb-2">
                    Deactivate Tool
                </div>

                <div class="danger-subtitle">
                    This will hide the tool from the portal while keeping its record available.
                </div>
            </div>

            <div>
                <a asp-action="Index" class="btn btn-light glass-btn">
                    ← Back
                </a>
            </div>

        </div>

        <div class="d-flex align-items-center gap-3 p-3 rounded-4 bg-white bg-opacity-75 mb-4">

            <img src="@(string.IsNullOrWhiteSpace(Model.LogoPath) ? Url.Content("~/images/logo-en.png") : Model.LogoPath)"
                 class="tool-logo-preview"
                 onerror="this.onerror=null;this.src='@Url.Content("~/images/logo-en.png")';" />

            <div>
                <div class="tool-name">
                    @Model.SysNameEn
                </div>

                <div class="tool-meta" dir="rtl">
                    @Model.SysNameAr
                </div>

                <div class="tool-meta mt-1">
                    @Model.AppUrl
                </div>
            </div>

        </div>

        <div class="alert alert-warning rounded-4 border-0 mb-4">
            Are you sure you want to deactivate this tool?
        </div>

        <form asp-action="DeleteConfirmed" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.CardId" />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index" class="btn btn-light glass-btn">
                    Cancel
                </a>

                <button type="submit" class="btn btn-danger glass-btn">
                    Deactivate Tool
                </button>

            </div>

        </form>

    </div>

</div>