@model BADEAPORTAL.Models.Announcements.AnnouncementCreateVm

@{
    ViewData["Title"] = "New announcement";
}

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">

<style>
    :root {
        --portal-hero-glass-bg: rgba(0, 0, 0, .55);
    }

    body,
    button,
    a,
    p,
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-family: 'Tajawal', sans-serif !important;
    }

    .create-shell {
        max-width: 1040px;
        margin: 1.75rem auto 0 auto;
    }

    .portal-hero {
        border-radius: 2rem;
        overflow: hidden;
        position: relative;
        box-shadow: 0 26px 80px rgba(0, 0, 0, .25);
        background: #000;
        min-height: 320px;
    }

    .portal-hero-bg-carousel img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .portal-hero-overlay {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(90deg, rgba(0, 0, 0, .86) 0%, rgba(0, 0, 0, .62) 35%, rgba(0, 0, 0, .18) 70%, rgba(0, 0, 0, .05) 100%),
            radial-gradient(circle at top left, rgba(255, 255, 255, .18), transparent 60%);
    }

    .portal-hero-inner {
        position: relative;
        z-index: 1;
        padding: 2.4rem 3.2rem;
        color: #fff;
        display: flex;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .portal-pill-badge {
        display: inline-flex;
        padding: .2rem .8rem;
        border-radius: 999px;
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        background: rgba(0, 0, 0, .6);
        color: #c0f3d2;
        border: 1px solid rgba(192, 243, 210, .45);
    }

    .hero-title {
        font-size: 2.1rem;
        font-weight: 850;
        text-shadow: 0 8px 26px rgba(0, 0, 0, .85);
    }

    .apple-card {
        border-radius: 1.8rem;
        background: #fff;
        border: 1px solid #e5e7eb;
        box-shadow: 0 18px 60px rgba(15, 29, 45, .12);
        overflow: hidden;
    }

    .apple-card-header {
        padding: 1.15rem 1.4rem;
        background: linear-gradient(180deg, #fbfdff, #fff);
        border-bottom: 1px solid #eef2f7;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .toggle-pill {
        display: inline-flex;
        gap: .55rem;
        padding: .35rem .85rem;
        border-radius: 999px;
        border: 1px solid #e5e7eb;
        background: #fff;
        box-shadow: 0 10px 26px rgba(15, 29, 45, .07);
    }

    .apple-card-body {
        padding: 1.35rem 1.4rem;
    }

    .field-label {
        font-size: .78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: #6b7280;
        margin-bottom: .35rem;
    }

    .premium-input {
        border-radius: 1.05rem !important;
        border: 1px solid #e5e7eb !important;
        box-shadow: 0 12px 28px rgba(15, 29, 45, .06);
    }

    .premium-editor-shell {
        border-radius: 1.4rem;
        border: 1px solid #e5e7eb;
        background: #fff;
        box-shadow: 0 18px 60px rgba(15, 29, 45, .12);
        overflow: hidden;
    }

    .premium-editor-toolbar {
        border-bottom: 1px solid #eef2f7;
        background: linear-gradient(180deg, #fbfdff, #fff);
        padding: .35rem .5rem;
    }

    .premium-editor {
        min-height: 320px;
        padding: 1rem;
    }

    .ql-editor table {
        width: 100%;
        border-collapse: collapse;
    }

    .ql-editor td,
    .ql-editor th {
        border: 1px solid #e5e7eb;
        padding: 6px;
    }

    .memo-panel {
        border-radius: 1.4rem;
        border: 1px solid #eef2f7;
        background: linear-gradient(180deg, #fbfdff, #fff);
        padding: 1.1rem;
        margin-top: 1rem;
        display: none;
    }

    .memo-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .pick-btn {
        width: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .typeahead-box {
        position: absolute;
        z-index: 9999;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 18px 60px rgba(15, 29, 45, .12);
        overflow: hidden;
        max-height: 280px;
        overflow-y: auto;
    }

    .typeahead-row {
        padding: 10px 12px;
        cursor: pointer;
    }

    .typeahead-row:hover {
        background: #f3f4f6;
    }
</style>

<div class="container-fluid px-0">
    <section class="mb-4">
        <div class="portal-hero">
            <div class="portal-hero-bg-carousel">
                <img src="~/images/announcement-hero.jpg" />
            </div>
            <div class="portal-hero-overlay"></div>

            <div class="portal-hero-inner">
                <div>
                    <div class="portal-pill-badge">BADEA · Create</div>
                    <div class="hero-title">New announcement.</div>
                </div>
                <a asp-action="Index" class="btn btn-outline-light">Back</a>
            </div>
        </div>
    </section>

    <div class="create-shell">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="apple-card">
                <div class="apple-card-header">
                    <div class="field-label">Announcement content</div>
                    <div class="toggle-pill">
                        <input asp-for="IsMemo" type="hidden" id="isMemoHidden" />
                        <input type="checkbox" id="isAnnouncementToggle" class="form-check-input m-0" />
                        <label for="isAnnouncementToggle">This is an announcement</label>
                    </div>
                    <button type="button" id="memoLangBtn" class="btn btn-outline-secondary premium-input">
                        Memo: English
                    </button>
                    <input type="hidden" id="memoLangHidden" value="en" />

                </div>

                <div class="apple-card-body">

                    <div class="mb-3">
                        <div class="field-label">Title</div>
                        <input asp-for="Title" class="form-control premium-input" />
                    </div>

                    <div id="memoFields" class="memo-panel">
                        <div class="memo-grid">
                            <!-- TO KIND -->
                            <div>
                                <div class="field-label">To type</div>
                                <select asp-for="ToKind" id="toKindSelect" class="form-select premium-input">
                                    <option value="USER">User</option>
                                    <option value="DEPT">Department</option>
                                </select>
                            </div>

                            <!-- TO -->
                            <div>
                                <div class="field-label">To</div>
                                <div class="input-group">
                                    <input asp-for="MemoTo" id="memoToInput" class="form-control premium-input"
                                        placeholder="Search..." autocomplete="off" />
                                    <button type="button" id="memoToBtn"
                                        class="btn btn-outline-secondary premium-input pick-btn">▾</button>
                                </div>
                                <input asp-for="ToDeptCode" type="hidden" id="toDeptCodeHidden" />
                            </div>


                            <!-- FROM KIND -->
                            <div>
                                <div class="field-label">From type</div>
                                <select asp-for="FromKind" id="fromKindSelect" class="form-select premium-input">
                                    <option value="USER">User</option>
                                    <option value="DEPT">Department</option>
                                </select>
                            </div>

                            <!-- FROM -->
                            <div>
                                <div class="field-label">From</div>
                                <div class="input-group">
                                    <input asp-for="MemoFrom" id="memoFromInput" class="form-control premium-input"
                                        placeholder="Search..." autocomplete="off" />
                                    <button type="button" id="memoFromBtn"
                                        class="btn btn-outline-secondary premium-input pick-btn">▾</button>
                                </div>
                                <input asp-for="FromDeptCode" type="hidden" id="fromDeptCodeHidden" />
                            </div>

                            <!-- THROUGH -->
                            <div>
                                <div class="field-label">Through (Department)</div>
                                <div class="input-group">
                                    <input asp-for="MemoThrough" id="memoThroughInput"
                                        class="form-control premium-input" placeholder="Search department..."
                                        autocomplete="off" />
                                    <button type="button" id="memoThroughBtn"
                                        class="btn btn-outline-secondary premium-input pick-btn">▾</button>
                                </div>
                            </div>

                            <div>
                                <div class="field-label">Subject</div>
                                <input asp-for="MemoSubject" class="form-control premium-input" placeholder="Subject" />
                            </div>

                            <div>
                                <div class="field-label">Classification</div>
                                <input asp-for="MemoClassification" class="form-control premium-input"
                                    placeholder="Classification" />
                            </div>

                            <div style="grid-column: 1 / -1;">
                                <div class="field-label">Notifications</div>
                                <div class="d-flex gap-4 align-items-center">
                                    <label class="d-flex align-items-center gap-2">
                                        <input asp-for="NotifyInApp" class="form-check-input m-0" />
                                        <span>In-app notification</span>
                                    </label>
                                    <label class="d-flex align-items-center gap-2">
                                        <input asp-for="NotifyEmail" class="form-check-input m-0" />
                                        <span>Also send email (later)</span>
                                    </label>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="mt-4">
                        <div class="field-label">Body</div>

                        <input asp-for="BodyHtml" type="hidden" id="BodyHtml" />

                        <div class="premium-editor-shell">
                            <div id="q-toolbar" class="premium-editor-toolbar">
                                <button class="ql-bold"></button>
                                <button class="ql-italic"></button>
                                <button class="ql-underline"></button>
                                <select class="ql-align"></select>
                                <button class="ql-list" value="bullet"></button>
                                <button class="ql-list" value="ordered"></button>
                                <button class="ql-direction" value="rtl"></button>
                                <button id="tbl-insert" type="button">▦</button>
                            </div>
                            <div id="q-editor" class="premium-editor"></div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button class="btn btn-success">Publish</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>

                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>

    <script>
        (() => {
            // -------------------------
            // Quill
            // -------------------------
            const quill = new Quill('#q-editor', { theme: 'snow', modules: { toolbar: '#q-toolbar', table: true } });

            const body = document.getElementById('BodyHtml');
            if (body && body.value) quill.clipboard.dangerouslyPasteHTML(body.value);

            const form = document.querySelector('form');
            form.addEventListener('submit', () => { body.value = quill.root.innerHTML; });

            // -------------------------
            // Memo toggle (default memo)
            // -------------------------
            const isMemoHidden = document.getElementById('isMemoHidden');
            const isAnnouncementToggle = document.getElementById('isAnnouncementToggle');
            const panel = document.getElementById('memoFields');

            function syncMemoToggle() {
                const isAnnouncement = isAnnouncementToggle.checked;
                isMemoHidden.value = (!isAnnouncement).toString();
                panel.style.display = (!isAnnouncement) ? 'block' : 'none';
            }

            isAnnouncementToggle.checked = false;
            syncMemoToggle();
            isAnnouncementToggle.addEventListener('change', syncMemoToggle);

            // -------------------------
            // Validation
            // -------------------------
            form.addEventListener('submit', e => {
                const txt = quill.getText().trim();
                if (!txt.length) { e.preventDefault(); alert('Body cannot be empty'); return; }

                const isMemo = (isMemoHidden.value === 'true');
                if (isMemo) {
                    const required = ['MemoTo', 'MemoFrom', 'MemoSubject', 'MemoClassification'];
                    for (const name of required) {
                        const el = document.querySelector(`[name="${name}"]`);
                        if (!el || !el.value.trim()) {
                            e.preventDefault();
                            if (el) el.focus();
                            alert('Please complete memo header fields');
                            return;
                        }
                    }
                }
            });

            // -------------------------
            // Helpers
            // -------------------------
            function getLabel(item) {
                return (item && (item.label ?? item.Label ?? "")) + "";
            }

            function stripEmpId(label) {
                if (!label) return '';
                return label.replace(/\s*\([^)]*\)\s*$/, '').trim(); // "Name (123)" => "Name"
            }

            // -------------------------
            // Memo language toggle (EN/AR)
            // -------------------------
            const memoLangHidden = document.getElementById('memoLangHidden');
            const memoLangBtn = document.getElementById('memoLangBtn');

            function getLang() {
                const v = (memoLangHidden?.value || "en").toLowerCase();
                return (v === "ar") ? "ar" : "en";
            }

            function setLang(lang) {
                const normalized = (String(lang).toLowerCase() === "ar") ? "ar" : "en";
                if (memoLangHidden) memoLangHidden.value = normalized;

                if (memoLangBtn) {
                    memoLangBtn.textContent = (normalized === "ar") ? "Memo: Arabic" : "Memo: English";
                }
            }

            // default
            setLang(getLang());

            if (memoLangBtn) {
                memoLangBtn.addEventListener('click', () => {
                    const next = (getLang() === "ar") ? "en" : "ar";
                    setLang(next);

                    // Optional but recommended: clear inputs so you immediately see new-language results
                    if (memoToInput) memoToInput.value = "";
                    if (memoFromInput) memoFromInput.value = "";
                    if (memoThroughInput) memoThroughInput.value = "";
                });
            }

            // -------------------------
            // Lookup base (respects /portalbadea)
            // -------------------------
            const lookupBase = '@Url.Content("~/api/lookup")';

            async function fetchJson(url) {
                const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return await res.json();
            }

            // ✅ IMPORTANT: include lang in ALL calls
            async function searchEmployees(q, take) {
                const lang = getLang();
                const url = `${lookupBase}/employees?q=${encodeURIComponent(q || "")}&take=${encodeURIComponent(take || 50)}&lang=${encodeURIComponent(lang)}`;
                return await fetchJson(url);
            }

            async function listEmployees(take) {
                const lang = getLang();
                const url = `${lookupBase}/employees/list?take=${encodeURIComponent(take || 300)}&lang=${encodeURIComponent(lang)}`;
                return await fetchJson(url);
            }

            async function searchDepartments(q, take) {
                const lang = getLang();
                const url = `${lookupBase}/departments?q=${encodeURIComponent(q || "")}&take=${encodeURIComponent(take || 50)}&lang=${encodeURIComponent(lang)}`;
                return await fetchJson(url);
            }
            async function listDepartments(take) {
                const lang = getLang();
                const url = `${lookupBase}/departments/list?take=${encodeURIComponent(take || 300)}&lang=${encodeURIComponent(lang)}`;
                return await fetchJson(url);
            }

            // -------------------------
            // Typeahead (robust)
            // - typing triggers search
            // - button opens dropdown
            // - doesn't close on scroll (only repositions)
            // -------------------------
            function attachTypeahead({ inputEl, buttonEl, fetcher, onPick, minChars = 1 }) {
                let box = null;
                let t = null;
                let lastReq = 0;

                function close() {
                    if (box) { box.remove(); box = null; }
                }

                function position() {
                    if (!box) return;
                    const rect = inputEl.getBoundingClientRect();
                    box.style.left = `${rect.left + window.scrollX}px`;
                    box.style.top = `${rect.bottom + window.scrollY + 6}px`;
                    box.style.width = `${rect.width}px`;
                }

                function render(items) {
                    close();
                    if (!items || !items.length) return;

                    box = document.createElement('div');
                    box.className = 'typeahead-box';

                    for (const item of items) {
                        const row = document.createElement('div');
                        row.className = 'typeahead-row';
                        row.textContent = getLabel(item);
                        row.addEventListener('mousedown', (e) => {
                            e.preventDefault();
                            onPick(item);
                            close();
                        });
                        box.appendChild(row);
                    }

                    document.body.appendChild(box);
                    position();
                }

                async function openList(q, take) {
                    const reqId = ++lastReq;
                    try {
                        const items = await fetcher(q, take);
                        if (reqId !== lastReq) return;
                        render(items);
                    } catch {
                        close();
                    }
                }

                function onInput() {
                    const q = (inputEl.value || '').trim();
                    clearTimeout(t);

                    if (q.length < minChars) { close(); return; }

                    t = setTimeout(() => openList(q, 50), 180); // typing search
                }

                function onButtonClick() {
                    const q = (inputEl.value || '').trim();
                    openList(q, 300);
                }

                function onDocClick(e) {
                    if (e.target === inputEl || e.target === buttonEl) return;
                    if (box && box.contains(e.target)) return;
                    close();
                }

                inputEl.addEventListener('input', onInput);
                document.addEventListener('click', onDocClick);
                window.addEventListener('resize', position);
                window.addEventListener('scroll', position, true);

                if (buttonEl) buttonEl.addEventListener('click', onButtonClick);

                return () => {
                    clearTimeout(t);
                    inputEl.removeEventListener('input', onInput);
                    document.removeEventListener('click', onDocClick);
                    window.removeEventListener('resize', position);
                    window.removeEventListener('scroll', position, true);
                    if (buttonEl) buttonEl.removeEventListener('click', onButtonClick);
                    close();
                };
            }

            // -------------------------
            // Elements
            // -------------------------
            const memoThroughInput = document.getElementById('memoThroughInput');
            const memoThroughBtn = document.getElementById('memoThroughBtn');

            const memoToInput = document.getElementById('memoToInput');
            const memoToBtn = document.getElementById('memoToBtn');
            const toKindSelect = document.getElementById('toKindSelect');
            const toDeptCodeHidden = document.getElementById('toDeptCodeHidden');

            const fromKindSelect = document.getElementById('fromKindSelect');
            const memoFromInput = document.getElementById('memoFromInput');
            const memoFromBtn = document.getElementById('memoFromBtn');
            const fromDeptCodeHidden = document.getElementById('fromDeptCodeHidden');

            // -------------------------
            // THROUGH (dept only)
            // -------------------------
            attachTypeahead({
                inputEl: memoThroughInput,
                buttonEl: memoThroughBtn,
                fetcher: (q, take) => {
                    const s = (q || "").trim();
                    return s.length ? searchDepartments(s, take) : listDepartments(take);
                },
                onPick: (item) => {
                    memoThroughInput.value = item.deptName || item.DeptName || stripEmpId(getLabel(item));
                },
                minChars: 1
            });

            // -------------------------
            // TO (user or dept)
            // -------------------------
            let disposeTo = null;

            function wireToPicker() {
                if (disposeTo) disposeTo();

                toDeptCodeHidden.value = "";
                memoToInput.value = "";

                if (toKindSelect.value === "DEPT") {
                    memoToInput.placeholder = "Search department...";
                    disposeTo = attachTypeahead({
                        inputEl: memoToInput,
                        buttonEl: memoToBtn,
                        fetcher: (q, take) => {
                            const s = (q || "").trim();
                            return s.length ? searchDepartments(s, take) : listDepartments(take);
                        },
                        onPick: (item) => {
                            memoToInput.value = item.deptName || item.DeptName || stripEmpId(getLabel(item));
                            toDeptCodeHidden.value = item.deptCode || item.DeptCode || '';
                        },
                        minChars: 1
                    });
                } else {
                    memoToInput.placeholder = "Search employee...";
                    disposeTo = attachTypeahead({
                        inputEl: memoToInput,
                        buttonEl: memoToBtn,
                        fetcher: (q, take) => {
                            const s = (q || "").trim();
                            return s.length ? searchEmployees(s, take) : listEmployees(take);
                        },
                        onPick: (item) => {
                            memoToInput.value = stripEmpId(getLabel(item));
                        },
                        minChars: 1
                    });
                }
            }

            toKindSelect.addEventListener('change', wireToPicker);
            wireToPicker();

            // -------------------------
            // FROM (user or dept)
            // -------------------------
            let disposeFrom = null;

            function wireFromPicker() {
                if (disposeFrom) disposeFrom();

                fromDeptCodeHidden.value = "";
                memoFromInput.value = "";

                if (fromKindSelect.value === "DEPT") {
                    memoFromInput.placeholder = "Search department...";
                    disposeFrom = attachTypeahead({
                        inputEl: memoFromInput,
                        buttonEl: memoFromBtn,
                        fetcher: (q, take) => {
                            const s = (q || "").trim();
                            return s.length ? searchDepartments(s, take) : listDepartments(take);
                        },
                        onPick: (item) => {
                            memoFromInput.value = item.deptName || item.DeptName || stripEmpId(getLabel(item));
                            fromDeptCodeHidden.value = item.deptCode || item.DeptCode || '';
                        },
                        minChars: 1
                    });
                } else {
                    memoFromInput.placeholder = "Search employee...";
                    disposeFrom = attachTypeahead({
                        inputEl: memoFromInput,
                        buttonEl: memoFromBtn,
                        fetcher: (q, take) => {
                            const s = (q || "").trim();
                            return s.length ? searchEmployees(s, take) : listEmployees(take);
                        },
                        onPick: (item) => {
                            memoFromInput.value = stripEmpId(getLabel(item));
                        },
                        minChars: 1
                    });
                }
            }

            fromKindSelect.addEventListener('change', wireFromPicker);
            wireFromPicker();

            // -------------------------
            // When language changes, keep wiring but clear inputs (so next open uses new lang)
            // -------------------------
            if (memoLangBtn) {
                memoLangBtn.addEventListener('click', () => {
                    // wire again in case you switch between DEPT/USER and want consistent behavior
                    wireToPicker();
                    wireFromPicker();
                });
            }

        })();
    </script>
}