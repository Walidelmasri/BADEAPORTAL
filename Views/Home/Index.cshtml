@foreach (var card in Model.SystemCards)
{
    var title = isArabic ? card.SysNameAr : card.SysNameEn;
    var description = isArabic ? card.DescriptionAr : card.DescriptionEn;
    var category = isArabic ? card.CategoryAr : card.CategoryEn;

    var logo = string.IsNullOrWhiteSpace(card.LogoPath)
        ? Url.Content("~/images/logo-en.png")
        : card.LogoPath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? card.LogoPath
            : Url.Content(card.LogoPath.StartsWith("~/") ? card.LogoPath : "~" + card.LogoPath);

    <div class="col-lg-4 col-md-6">
        <a href="@card.AppUrl"
           target="_blank"
           rel="noopener noreferrer"
           class="portal-tool-card text-decoration-none text-dark d-block">

            <div class="portal-tool-layout">
                <div class="portal-tool-body">
                    <h5 class="mb-1 portal-tool-title">@title</h5>

                    @if (!string.IsNullOrWhiteSpace(category))
                    {
                        <div class="portal-tool-meta mb-2">@category</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(description))
                    {
                        <p class="mb-3 small text-muted">@description</p>
                    }

                    <span class="portal-chip">@(isArabic ? "داخلي" : "Internal")</span>
                </div>

                <div class="portal-tool-visual">
                    <img src="@logo"
                         alt="@title"
                         class="portal-tool-logo-img"
                         onerror="this.onerror=null;this.src='@Url.Content("~/images/logo-en.png")';" />
                </div>
            </div>
        </a>
    </div>
}
