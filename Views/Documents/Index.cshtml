@model IReadOnlyList<BADEAPORTAL.Models.Documents.DocumentListItemVm>
@{
    ViewData["Title"] = "Documents";

    var currentFolderPath = ViewBag.CurrentFolderPath as string ?? "";

    string? parentFolderPath = null;

    if (!string.IsNullOrWhiteSpace(currentFolderPath))
    {
        var lastSlashIndex = currentFolderPath.LastIndexOf('/');

        parentFolderPath =
            lastSlashIndex >= 0
                ? currentFolderPath[..lastSlashIndex]
                : "";
    }
}

<style>
    .documents-page {
        font-family: 'Tajawal', sans-serif;
    }

    .documents-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        padding: 2rem;
        background:
            linear-gradient(135deg, rgba(13, 110, 253, 0.10), rgba(111, 66, 193, 0.08)),
            rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.45);
        box-shadow:
            0 10px 35px rgba(0, 0, 0, 0.06),
            inset 0 1px 0 rgba(255, 255, 255, 0.55);
    }

    .documents-hero::before {
        content: "";
        position: absolute;
        top: -120px;
        right: -120px;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: rgba(13, 110, 253, 0.08);
    }

    .documents-title {
        font-size: 2rem;
        font-weight: 700;
        color: #111827;
    }

    .documents-subtitle {
        color: #6b7280;
        font-size: 1rem;
    }

    .documents-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.45);
        border-radius: 24px;
        box-shadow:
            0 10px 30px rgba(0, 0, 0, 0.05),
            inset 0 1px 0 rgba(255, 255, 255, 0.5);
    }

    .documents-table th {
        font-size: 0.9rem;
        font-weight: 700;
        color: #6b7280;
        border-bottom: 1px solid #eef2f7;
        background: transparent !important;
        padding: 1rem;
    }

    .documents-table td {
        padding: 1rem;
        vertical-align: middle;
        border-bottom: 1px solid #f3f4f6;
    }

    .documents-table tr:last-child td {
        border-bottom: none;
    }

    .document-name {
        font-weight: 600;
        color: #111827;
    }

    .document-meta {
        color: #6b7280;
        font-size: 0.92rem;
    }

    .folder-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .file-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
        background: rgba(108, 117, 125, 0.12);
        color: #495057;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .glass-btn {
        border-radius: 14px;
        padding: 0.6rem 1rem;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: all 0.2s ease;
    }

    .glass-btn:hover {
        transform: translateY(-1px);
    }

    .upload-card {
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.45);
        box-shadow:
            0 8px 25px rgba(0, 0, 0, 0.04),
            inset 0 1px 0 rgba(255, 255, 255, 0.55);
    }

    .custom-file-input {
        border-radius: 14px;
        min-height: 52px;
        border: 1px solid #dbe2ea;
        padding: 0.8rem 1rem;
    }

    .path-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 0.9rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.08);
        color: #0d6efd;
        font-weight: 600;
        font-size: 0.88rem;
    }

    .empty-state {
        padding: 3rem 2rem;
        text-align: center;
        color: #6b7280;
    }

    .alert {
        border-radius: 18px;
        border: none;
    }
</style>

<div class="container py-4 documents-page">

    <div class="documents-hero mb-4">

        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

            <div>
                <div class="documents-title mb-2">
                    Document Management
                </div>

                <div class="documents-subtitle mb-3">
                    Centralized enterprise document library powered by SharePoint integration
                </div>

                @if (string.IsNullOrWhiteSpace(currentFolderPath))
                {
                    <div class="path-pill">
                        Root Folder
                    </div>
                }
                else
                {
                    <div class="path-pill">
                        @currentFolderPath
                    </div>
                }
            </div>

            <div class="d-flex align-items-center gap-2">

                @if (!string.IsNullOrWhiteSpace(currentFolderPath))
                {
                    <a asp-controller="Documents" asp-action="Index" asp-route-folderPath="@parentFolderPath"
                           class="btn btn-light glass-btn">
                        ← Back
                    </a>
                }

            </div>

        </div>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm mb-4">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm mb-4">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger shadow-sm mb-4">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="upload-card p-4 mb-4">


        <form asp-controller="Documents" asp-action="Upload" method="post" enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden" name="folderPath" value="@currentFolderPath" />

            <div class="row g-3">

                <div class="col-lg-6">
                    <label class="form-label fw-semibold mb-2">
                        Document Name
                    </label>

                    <input type="text" name="name" class="form-control custom-file-input"
                           placeholder="Example: HR Policy" />
                </div>

                <div class="col-lg-6">
                    <label class="form-label fw-semibold mb-2">
                        Upload File
                    </label>

                    <input type="file" name="file" class="form-control custom-file-input"
                           accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.png,.jpg,.jpeg" />

                    <div class="form-text mt-2">
                        Allowed: PDF, Word, Excel, PowerPoint, PNG, JPG — Maximum 10 MB
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold mb-2">
                        Description
                    </label>

                    <textarea name="description" class="form-control custom-file-input" rows="3"
                              placeholder="Optional document description"></textarea>
                </div>

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary glass-btn px-4">
                        Upload Document
                    </button>
                </div>

            </div>

        </form>
    </div>
</div>

<div class="documents-card p-0 overflow-hidden">

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h5 class="fw-bold mb-2">
                No Documents Found
            </h5>

            <p class="mb-0">
                This folder currently does not contain any files or folders.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table documents-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Size</th>
                        <th>Last Modified</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <div class="document-name">
                                    @item.Name
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="document-meta mt-1">
                                        @item.Description
                                    </div>
                                }
                            </td>

                            <td>

                                @if (item.IsFolder)
                                {
                                    <span class="folder-badge">
                                        Folder
                                    </span>
                                }
                                else
                                {
                                    <span class="file-badge">
                                        File
                                    </span>
                                }

                            </td>

                            <td class="document-meta">

                                @if (item.IsFolder)
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    var sizeText = item.Size.HasValue
                                        ? $"{Math.Round(item.Size.Value / 1024.0, 2)} KB"
                                        : "-";

                                    @sizeText
                                }

                            </td>

                            <td class="document-meta">
                                @(item.LastModifiedDateTime?.ToLocalTime()
                                    .ToString("dd MMM yyyy hh:mm tt"))
                            </td>

                            <td class="text-end">

                                @if (item.IsFolder)
                                {
                                    <a asp-controller="Documents" asp-action="Index" asp-route-folderPath="@item.FolderPath"
                                           class="btn btn-outline-primary glass-btn btn-sm">
                                        Open
                                    </a>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-end gap-2">

                                        <button type="button" class="btn btn-outline-secondary glass-btn btn-sm history-btn"
                                                data-document-id="@item.DocumentId">
                                            History
                                        </button>

                                        <a asp-controller="Documents" asp-action="Download"
                                               asp-route-itemId="@item.SharePointItemId" class="btn btn-primary glass-btn btn-sm">
                                            Download
                                        </a>

                                    </div>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content border-0 shadow-lg">

            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    Document Version History
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>

            <div class="modal-body" id="historyModalBody">

                <div class="text-center py-4">
                    Loading history...
                </div>

            </div>

        </div>

    </div>

</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const modalElement =
            document.getElementById("historyModal");

        const modal =
            new bootstrap.Modal(modalElement);

        const modalBody =
            document.getElementById("historyModalBody");

        document.querySelectorAll(".history-btn")
            .forEach(button => {

                button.addEventListener("click", async function () {

                    const documentId =
                        this.dataset.documentId;

                    modalBody.innerHTML =
                        `<div class="text-center py-4">
                            Loading history...
                         </div>`;

                    modal.show();

                    try {

                        const response =
                            await fetch(`/portalbadea/Documents/HistoryModal?documentId=${documentId}`);

                        const html =
                            await response.text();

                        modalBody.innerHTML = html;

                    } catch {

                        modalBody.innerHTML =
                            `<div class="alert alert-danger">
                                Failed to load document history.
                             </div>`;
                    }

                });

            });

    });
</script>