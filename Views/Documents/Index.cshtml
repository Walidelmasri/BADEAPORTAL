@model IReadOnlyList<BADEAPORTAL.Models.Documents.SharePointDocumentVm>

@{
    ViewData["Title"] = "Documents";

    var currentFolderPath = ViewBag.CurrentFolderPath as string ?? "";

    string? parentFolderPath = null;

    if (!string.IsNullOrWhiteSpace(currentFolderPath))
    {
        var lastSlashIndex = currentFolderPath.LastIndexOf('/');

        parentFolderPath =
            lastSlashIndex >= 0
                ? currentFolderPath[..lastSlashIndex]
                : "";
    }
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Documents</h2>

            @if (string.IsNullOrWhiteSpace(currentFolderPath))
            {
                <p class="text-muted mb-0">
                    Root Folder
                </p>
            }
            else
            {
                <p class="text-muted mb-0">
                    @currentFolderPath
                </p>
            }
        </div>

    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="mb-3">

        @if (!string.IsNullOrWhiteSpace(currentFolderPath))
        {
            <a asp-controller="Documents"
               asp-action="Index"
               asp-route-folderPath="@parentFolderPath"
               class="btn btn-outline-secondary btn-sm">
                ← Back
            </a>
        }

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No documents were found.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Last Modified</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @item.Name
                                </td>

                                <td>
                                    @(item.IsFolder ? "Folder" : "File")
                                </td>

                                <td>

                                    @if (item.IsFolder)
                                    {
                                        <span>-</span>
                                    }
                                    else
                                    {
                                        var sizeText = item.Size.HasValue
                                            ? $"{Math.Round(item.Size.Value / 1024.0, 2)} KB"
                                            : "-";

                                        @sizeText
                                    }

                                </td>

                                <td>
                                    @(item.LastModifiedDateTime?.ToLocalTime()
                                        .ToString("dd MMM yyyy hh:mm tt"))
                                </td>

                                <td class="text-end">

                                    @if (item.IsFolder)
                                    {
                                        <a asp-controller="Documents"
                                           asp-action="Index"
                                           asp-route-folderPath="@item.FolderPath"
                                           class="btn btn-sm btn-outline-primary">
                                            Open
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Documents"
                                           asp-action="Download"
                                           asp-route-itemId="@item.ItemId"
                                           class="btn btn-sm btn-primary">
                                            Download
                                        </a>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>