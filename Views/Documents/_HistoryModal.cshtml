@model IReadOnlyList<BADEAPORTAL.Models.Documents.PortalDocumentVersion>

@if (!Model.Any())
{
    <div class="text-muted">
        No version history found for this document.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Version</th>
                    <th>File Name</th>
                    <th>Type</th>
                    <th>Size</th>
                    <th>Uploaded By</th>
                    <th>Uploaded At</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var version in Model)
                {
                    var sizeText = version.FileSize.HasValue
                        ? $"{Math.Round(version.FileSize.Value / 1024.0, 2)} KB"
                        : "-";

                    <tr>
                        <td>v@version.VersionNo</td>
                        <td>@version.OriginalFileName</td>
                        <td>@version.FileType</td>
                        <td>@sizeText</td>
                        <td>@version.UploadedBy</td>
                        <td>@version.UploadedAt.ToString("dd MMM yyyy hh:mm tt")</td>
                        <td>
                            @if (version.IsCurrent == 1)
                            {
                                <span class="badge bg-success">Current</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Old</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}